DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Add these callback URLs as authorized redirects in Google Cloud Console:
# http://localhost:3000/api/integrations/classroom/callback
# http://localhost:3000/api/integrations/calendar/callback
# http://localhost:3000/api/integrations/drive/callback

# Optional AI providers. If unset, the app uses its demo provider.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Required for the scheduled Vercel task and Classroom sync job.
CRON_SECRET=""
# Keep true for local demo mode. Set false after configuring an AI provider.
ALLOW_MOCK_AI="true"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM="VidyaSarthi <noreply@example.com>"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
# Configure Stripe to send subscription events to /api/subscription/webhook.

# Production infrastructure (required before production launch)
# DATABASE_URL="postgresql://user:password@host:5432/backoff?connection_limit=5&pool_timeout=10"
# Vercel uses `npm run build:vercel`, which generates Prisma Client from the PostgreSQL schema.
# Apply the PostgreSQL migration baseline before the first production deploy.
# REDIS_URL="redis://localhost:6379"
# Queue execution: inline (tests, simple local dev) or redis (staging/prod worker).
# JOB_EXECUTION_MODE="inline"
# WORKER_CONCURRENCY="5"
# The current S3 adapter is incomplete. It does not read or delete remote objects.
# Do not use these settings for production uploads until the adapter is complete.
# S3_BUCKET="vidyasarthi-files"
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# AV_SCAN_URL=""
# ENCRYPTION_KEY="32-byte-minimum-secret-for-oauth-tokens"
# SENTRY_DSN=""
# LOCAL_STORAGE_DIR="./storage"
